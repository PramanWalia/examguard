{
  "name": "@examguard/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=src src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:contract": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand src/tests/contract.test.js",
    "test:mongo": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand src/tests/mongoRepositories.test.js src/tests/mongoContract.test.js src/tests/mongoExplain.test.js src/tests/mongoSeed.test.js src/tests/mongoIntegration.test.js",
    "seed": "node src/seed.js",
    "create-admin": "node src/createAdmin.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.7",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^3.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^2.0.12",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.4.3",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0"
  }
}
