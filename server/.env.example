NODE_ENV=development
PORT=4000
REPOSITORY_DRIVER=memory
# For production or persistent dev, set REPOSITORY_DRIVER=mongo and supply MONGODB_URI
MONGODB_URI=mongodb://127.0.0.1:27017/examguard
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN=

# Generate strong secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-64-char-random-secret-for-production
JWT_REFRESH_SECRET=replace-with-another-64-char-random-secret-for-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECURE=false
TRUST_PROXY=false

# Optional teacher auto-approval invite code (leave blank to require manual admin approval)
TEACHER_INVITE_CODE=

# Optional initial administrator provisioning on startup (auto-creates if missing)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Security & rate limiting
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5000
AUTH_RATE_LIMIT_MAX=1000
IMPORT_MAX_BYTES=5242880
HEARTBEAT_TIMEOUT_SECONDS=90
MAX_ANSWER_GAP_SECONDS=300

# Seeding (disallowed when NODE_ENV=production)
SEED_ON_START=false
