{
  "name": "examguard",
  "private": true,
  "version": "0.1.0",
  "description": "ExamGuard online examination platform",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @examguard/server",
    "dev:client": "npm run dev --workspace @examguard/client",
    "build": "npm run build --workspace @examguard/client",
    "start": "npm run start --workspace @examguard/server",
    "lint": "npm run lint --workspaces",
    "format": "npm run format --workspaces",
    "test": "npm run test --workspace @examguard/server",
    "test:mongo": "npm run test:mongo --workspace @examguard/server",
    "test:client": "npm run test --workspace @examguard/client"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "msw": {
    "workerDirectory": [
      "client\\public"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
