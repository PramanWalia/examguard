# ExamGuard Environment Configuration
# Copy this file to server/.env and client/.env for local development.

# Server runtime
NODE_ENV=development
PORT=4000
REPOSITORY_DRIVER=memory
MONGODB_URI=mongodb://127.0.0.1:27017/examguard
CORS_ORIGIN=http://localhost:5173

# Authentication secrets (MUST be overridden with strong secrets in production)
JWT_ACCESS_SECRET=replace-with-strong-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECURE=false

# Teacher registration invite code (optional; if unset or omitted, teacher signups require admin approval)
TEACHER_INVITE_CODE=

# Demo data seeding (NEVER enable in production; server refuses to start/seed when NODE_ENV=production)
SEED_ON_START=false

# Client configuration
VITE_API_URL=http://localhost:4000/api/v1
VITE_ENABLE_MSW=false